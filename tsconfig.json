{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": [".astro/types.d.ts", "src/**/*", "components/**/*", "context/**/*", "content/**/*", "lib/**/*", "email/**/*", "cloudflare-env.d.ts"],
  "exclude": ["node_modules", "dist", ".next", ".open-next", "app", "next-env.d.ts", "next.config.ts", "open-next.config.ts"]
}
